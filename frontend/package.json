    "gen:chakra": "pnpm chakra typegen src/theme/system.ts",
    "gen": "pnpm gen:routes && pnpm gen:chakra",
    "build": "./scripts/build-release.sh",
    "build:production": "./scripts/build-release.sh production",
    "lint": "./scripts/lint.sh",
    "lint:fix": "./scripts/lint-fix.sh"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.21.0",
    "@suspensive/react": "^2.18.12",
