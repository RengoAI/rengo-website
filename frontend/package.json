{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "v23.5.0",
    "pnpm": "9.15.2"
  },
  "scripts": {
    "start": "VITE_ENABLE_HTTPS=1 vite",
    "gen:routes": "pnpm vite-node src/scripts/generate-routes.ts && pnpm eslint --fix src/app/app-routes.ts",
    "gen:chakra": "pnpm chakra typegen src/theme/system.ts",
    "gen": "pnpm gen:routes && pnpm gen:chakra",
    "build": "./scripts/build-release.sh",
    "build:production": "./scripts/build-release.sh production",
    "lint": "./scripts/lint.sh",
    "lint:fix": "./scripts/lint-fix.sh"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@suspensive/react": "^3.21.4",
    "color2k": "^2.0.4",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "typesafe-routes": "^10.0.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-absolute-imports": "^0.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.6.3",
    "vite": "^6.4.4",
    "vite-node": "^6.0.0",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
