{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "v23.5.0",
    "pnpm": "9.15.2"
  },
  "scripts": {
    "start": "VITE_ENABLE_HTTPS=1 vite",
